{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/qr-resolve.js": {
      "includeFiles": "backend/datasets/**"
    },
    "api/extension.js": {
      "maxDuration": 120,
      "includeFiles": "backend/datasets/**"
    },
    "api/detect.js": {
      "maxDuration": 120,
      "includeFiles": "backend/datasets/**"
    }
  }
}
