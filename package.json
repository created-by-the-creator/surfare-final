{
  "name": "surfare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n frontend,backend -c cyan,magenta \"npm run dev --workspace frontend\" \"npm run backend:dev\"",
    "build": "npm run build --workspace frontend",
    "extension:build": "vite build --config extension/vite.config.js --mode extension",
    "extension:test": "node --test extension/tests/*.test.mjs",
    "test": "npm run test --workspace frontend",
    "test:local-messages": "npm run test --workspace frontend -- src/engine/local-benchmark.test.js",
    "test:local-generalization": "npm run test --workspace frontend -- src/engine/generalization.test.js",
    "preview": "npm run preview --workspace frontend",
    "backend:dev": "npm run dev --workspace backend",
    "backend:start": "npm run start --workspace backend",
    "backend:test": "npm run test --workspace backend",
    "build:browser-references": "npm run build:browser-url-indexes --workspace backend",
    "worker:dev": "npm run worker:dev --workspace backend",
    "worker:deploy": "npm run worker:deploy --workspace backend"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
